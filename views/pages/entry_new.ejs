<%- include('../partials/top', { title }) %>
<div class="cp"><div class="crumbs"><span class="muted small">①</span><a href="/accounting/entries">Journal Entries</a><span class="sep">/</span><span>New (manual)</span></div><div></div></div>
<form method="post" action="/accounting/entries/new">
<input type="hidden" name="_csrf" value="<%= csrf %>">
<div class="formbar"><div class="left"><button class="btn btn-primary">Save Draft</button><a class="btn" href="/accounting/entries">Discard</a></div><span class="statusbar"><span class="on">Draft</span><span>Posted</span></span></div>
<div class="sheet">
  <h1>Jurnal manual</h1>
  <div class="fields"><div><div class="field"><label for="date">Date</label><input id="date" name="date" type="date"></div></div><div><div class="field"><label for="ref">Reference</label><input id="ref" name="ref" required></div></div></div>
  <table class="list"><thead><tr><th>Account</th><th>Label</th><th class="num">Debit</th><th class="num">Credit</th></tr></thead><tbody>
    <% for (let i = 0; i < 4; i++) { %><tr><td><select name="lines[<%= i %>][account]" class="input"><option value="">—</option><% for (const a of accounts) { %><option value="<%= a.code %>"><%= a.code %> <%= a.name %></option><% } %></select></td><td><input class="input" name="lines[<%= i %>][label]"></td><td class="num"><input class="input-sm" name="lines[<%= i %>][debit]"></td><td class="num"><input class="input-sm" name="lines[<%= i %>][credit]"></td></tr><% } %>
  </tbody></table>
  <div class="callout small">Jurnal harus seimbang (debit = kredit) untuk disimpan; diposting terpisah dan hanya sekali (SR-12).</div>
</div>
</form>
<%- include('../partials/bottom') %>
