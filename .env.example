# Salin menjadi .env lalu sesuaikan.
PORT=3000
# Opsi 1: satu URL (contoh Aiven): mysql://avnadmin:PASSWORD@HOST:PORT/defaultdb
DATABASE_URL=
# Opsi 2: field terpisah (dipakai jika DATABASE_URL kosong)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=nusabite
DB_PASSWORD=nusabite
DB_NAME=nusabite
# true untuk database cloud yang mewajibkan TLS (Aiven, TiDB, dll.)
DB_SSL=false
# Isi dengan sertifikat CA (PEM) dari penyedia database agar sertifikat server diverifikasi
DB_SSL_CA=
SESSION_SECRET=ganti-dengan-teks-acak-panjang
# Password semua akun uji (sales.demo, warehouse.demo, finance.demo, hr.demo, cashier.demo, owner.demo)
DEMO_PASSWORD=demo1234
# Izinkan Owner memulihkan baseline seed dari menu Configuration
ALLOW_RESET=true
